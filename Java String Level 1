Q9. Convert Text to Uppercase
import java.util.Scanner;
public class UpperCase {
    static String convertToUpper(String text) {
        String result = "";
        for (int i = 0; i < text.length(); i++) {
            char ch = text.charAt(i);
            if (ch >= 'a' && ch <= 'z')
                ch = (char)(ch - 32);
            result += ch;
        }
        return result;
    }
    static boolean compareStrings(String a, String b) {
        if (a.length() != b.length())
            return false;
        for (int i = 0; i < a.length(); i++)
            if (a.charAt(i) != b.charAt(i))
                return false;
        return true;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String text = sc.nextLine();
        String result1 = convertToUpper(text);
        String result2 = text.toUpperCase();
        System.out.println("Converted text: " + result1);
        System.out.println("Both results are same: " + compareStrings(result1, result2));
    }
}

Q10. Convert Text to Lowercase
import java.util.Scanner;
public class LowerCase {
    static String convertToLower(String text) {
        String result = "";
        for (int i = 0; i < text.length(); i++) {
            char ch = text.charAt(i);
            if (ch >= 'A' && ch <= 'Z')
                ch = (char)(ch + 32);
            result += ch;
        }
        return result;
    }
    static boolean compareStrings(String a, String b) {
        if (a.length() != b.length())
            return false;
        for (int i = 0; i < a.length(); i++)
            if (a.charAt(i) != b.charAt(i))
                return false;
        return true;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String text = sc.nextLine();
        String result1 = convertToLower(text);
        String result2 = text.toLowerCase();
        System.out.println("Converted text: " + result1);
        System.out.println("Both results are same: " + compareStrings(result1, result2));
    }
}